@startuml
participant Component as "SmartMedia"
participant URL as "URL Handler"
participant Localhost as "localhost:8080"
participant Server as "Original Server"
participant State as "Component State"

note over Component: useEffect triggered
activate Component

Component -> URL: Create URL object\nfrom source
activate URL

URL -> URL: Extract pathname
URL -> URL: Build localhost URL\n(http://127.0.0.1:8080/path)

URL -> Localhost: HEAD request
activate Localhost

alt Localhost responds
    Localhost --> URL: 200 OK
    URL -> State: setFinalUrl(localhost URL)
else Localhost unreachable/404
    Localhost --> URL: Error/404
    URL -> State: setFinalUrl(original URL)
    note right: Fallback to original
end
deactivate Localhost

URL -> Server: HEAD request for content-type
activate Server

alt Valid response
    Server --> URL: content-type header
    URL -> URL: Check media type
    alt content-type starts with "image/"
        URL -> State: setMediaType("image")
    else content-type starts with "video/"
        URL -> State: setMediaType("video")
    else other content-type
        URL -> State: setError("Unsupported type")
    end
else Server error
    Server --> URL: Error
    URL -> State: setError("Network error")
end
deactivate Server

URL -> State: setIsLoading(false)
deactivate URL

alt mediaType is "image"
    Component -> Component: render <img>
else mediaType is "video"
    Component -> Component: render <video>
else error state
    Component -> Component: render error message
end

deactivate Component
@enduml